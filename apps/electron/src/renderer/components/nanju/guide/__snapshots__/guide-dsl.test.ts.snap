        TEST_ATK --> TEST_DEF["防御者裁决"]
        TEST_DEF -->|"red → 修复后重新攻击"| TEST_ATK
        TEST_DEF -->|"无 red"| TEST_GWT{"Harness 执行 GWT<br/>场景×步骤 · data-ai-id 锚点"}
        TEST_GWT -->|"❌ 失败场景 → 回炉 coding（≤2 次）"| TEST
        TEST_GWT -->|"全场景通过"| TEST_JUDGE{"规则裁判 judge.verdict<br/>全通过 + US 全覆盖 = 交付"}
    end

    TEST_JUDGE -->|"全场景通过 · 裁判判定"| DONE(["交付 delivered<br/>项目可用 · 验收交付完成"])

    classDef st-done fill:#A7F3D0,stroke:#059669,stroke-width:2px,color:#064E3B
    classDef st-sub-done fill:#D1FAE5,stroke:#059669,color:#065F46
