    class PLAN_ATK,PLAN_DEF,PLAN_UC st-pending
    class CODE st-pending
    class CODE_ATK,CODE_DEF,CODE_UC st-pending
    class TEST st-pending
    class TEST_ATK,TEST_DEF,TEST_GWT,TEST_JUDGE st-pending
    class REQ_ATK,REQ_DEF,REQ_UC st-sub-done
    class PROTO_SS,PROTO_VIS,PROTO_ATK,PROTO_DEF,PROTO_UC st-sub-done
    linkStyle 7,18 stroke:#059669,stroke-width:2.5px
"
`;
